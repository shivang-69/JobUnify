{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://jobunify.onrender.com/sitemap.xml"
    },
    {
      "source": "/api/jobs/detail/:id",
      "destination": "https://jobunify.onrender.com/api/jobs/detail/:id"
    },
    {
      "source": "/jobs/:role",
      "destination": "https://jobunify.onrender.com/jobs/:role"
    }
  ]
}
